{
  "prefix": "ugcportal",
  "out": ".runtime/dashboard.html",
  "releaseLabelPattern": "^v\\d+\\.\\d+\\.\\d+$",
  "releaseLabelGlob": "v*.*.*",
  "humanWaitPrLabels": [
    "needs-human-merge"
  ],
  "humanWaitBeadLabels": [
    "stalled-on-human",
    "human-only"
  ],
  "cmuxConfig": ".cmux/cmux.json",
  "cmuxWorkspace": "ugcportal dashboard",
  "cmuxAction": "ugcportal-dashboard",
  "command": "sh scripts/dashboard.sh github:eiriksf-capgemini/bead-dashboard#26549cef52cd07c1d22cdde57d811af8aecaf351"
}
