// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum MediaKind {
  IMAGE
  VIDEO
}

// Core user record. Shape follows the Auth.js Prisma adapter convention
// (https://authjs.dev/getting-started/adapters/prisma) so the upcoming
// Google/Facebook OAuth work (ugcportal-3vy, ugcportal-3zj) can plug in
// without a schema migration.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  media             Media[]
  instagramAccounts InstagramAccount[]
}

// One row per linked login provider (Google, Facebook, ...) for a user.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One row per uploaded file (ugcportal-8wa). `key` is the object's path in
// the S3-compatible bucket (see src/lib/s3.ts); the file bytes themselves
// live only in storage, never in the DB.
model Media {
  id           String    @id @default(cuid())
  userId       String
  kind         MediaKind
  key          String    @unique
  mimeType     String
  sizeBytes    Int
  originalName String
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One connected Instagram account whose media can be synced (ugcportal-ct0)
// and later curated for sale (ugcportal-74w). Several accounts can be
// connected; `connectedBy` records which admin authorised this one.
//
// `accessTokenEncrypted` holds a long-lived Instagram token sealed with
// AES-256-GCM (see src/lib/crypto.ts) rather than the plaintext the Auth.js
// `Account` table stores — these tokens are a standing capability over
// someone else's content, not a login artefact, so they never sit in the
// clear at rest. Refresh before `tokenExpiresAt` is ugcportal-cud's job.
model InstagramAccount {
  id                   String   @id @default(cuid())
  instagramUserId      String   @unique
  username             String
  accessTokenEncrypted String
  tokenExpiresAt       DateTime
  scopes               String
  connectedByUserId    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  connectedBy User @relation(fields: [connectedByUserId], references: [id], onDelete: Cascade)

  @@index([connectedByUserId])
}

// Where a role change came from. `BOOTSTRAP` is the first-admin path, which
// by definition has no admin behind it (see ADMIN_BOOTSTRAP_EMAILS in
// env.example); `ADMIN` is every change made from the admin users screen.
enum RoleChangeSource {
  BOOTSTRAP
  ADMIN
}

// Append-only audit trail of every User.role change (ugcportal-lu7). Nothing
// updates or deletes these rows; the current role lives on User, this is the
// history of how it got there.
//
// Deliberately carries no foreign keys. An audit row whose FK cascades away
// when the user is deleted stops being an audit trail exactly when it matters
// most, and a restricting FK would block deleting a user at all (GDPR erasure
// is ugcportal-x1a's problem, not something an audit log should veto). The ids
// are kept as plain strings, with the email snapshotted alongside so a row
// still reads sensibly after the account is gone.
model RoleChange {
  id           String           @id @default(cuid())
  targetUserId String
  targetEmail  String?
  previousRole Role
  newRole      Role
  source       RoleChangeSource
  actorUserId  String?
  actorEmail   String?
  createdAt    DateTime         @default(now())

  @@index([targetUserId])
  @@index([createdAt])
}
