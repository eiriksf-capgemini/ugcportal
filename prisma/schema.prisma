// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Enables the partial-index `where:` argument on `@@index`, used below on
  // Media's public-feed index (ugcportal-ei7). Verified against Prisma 7.10
  // to be real and not preview-flagged drift: with this on, `prisma migrate
  // diff` emits exactly the intended `CREATE INDEX ... WHERE ...` DDL and
  // nothing else changes for any other model. See the index comment in the
  // Media model for the measurement this enabled.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum MediaKind {
  IMAGE
  VIDEO
}

// Core user record. Shape follows the Auth.js Prisma adapter convention
// (https://authjs.dev/getting-started/adapters/prisma) so the upcoming
// Google/Facebook OAuth work (ugcportal-3vy, ugcportal-3zj) can plug in
// without a schema migration.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // WHICH CONFIGURED PERSON THIS ROW IS (ugcportal-t33p): the stable handle
  // derived from `name` in src/config/users.ts (`configuredUserHandle`), and
  // the only key a configured person's row is ever looked up by at sign-in.
  //
  // It exists because the alternative is e-mail, and e-mail is exactly what
  // cannot answer the question. @auth/core links an Account by the
  // provider's stable subject and falls back to `User.email`, so one person
  // arriving through two providers with two addresses becomes two users —
  // two upload histories, two role rows. The handle is the one value that is
  // the same for both of their identities, and it comes from configuration
  // rather than from anything a provider asserts.
  //
  // NULLABLE, and null is the ordinary case for anyone not in the array:
  // somebody admitted by ALLOWED_SIGNIN_EMAILS alone keeps the unmodified
  // Auth.js behaviour, one user per identity. SQLite (and Prisma) allow any
  // number of NULLs under a UNIQUE index, which is what makes "unique among
  // configured people, absent for everyone else" expressible in one column.
  //
  // UNIQUE because two rows claiming the same person is the split this
  // column removes; the adapter wrapper in src/lib/configured-user-link.ts
  // relies on the constraint to settle a race between two simultaneous first
  // sign-ins, and src/instrumentation.ts reports two configured names that
  // would slug to the same handle before either of them ever signs in.
  //
  // NOT a foreign key to anything and not an enum: the array is committed
  // TypeScript, not a table, so the database cannot check this value and
  // must not pretend to. A handle here that no longer appears in the array
  // (a person removed, or renamed) is an orphan the next sign-in would walk
  // past — see "Renaming a person" in docs/access-control.md.
  configuredHandle String? @unique

  accounts           Account[]
  sessions           Session[]
  media              Media[]
  instagramAccounts  InstagramAccount[]
  // THE anchor of the resale-rights gate (ugcportal-vsm). One standing
  // review per uploader, answering "may this person's uploads be resold at
  // all, and is that answer still current". The gate reaches it through
  // Media.userId, never through a column a listing's author chooses.
  resaleRightsReview ResaleRightsReview?    @relation("ResaleRightsSubject")
  // Resale-rights reviews this user signed off (ugcportal-0ss). Named so the
  // relation stays unambiguous against the anchor above.
  resaleReviews      ResaleRightsReview[]   @relation("ResaleRightsReviewer")
  layerClearances    MediaRightsClearance[] @relation("MediaRightsClearer")
  triagedListings    MediaListing[]         @relation("MediaListingTriager")
}

// One row per linked login provider (Google, Facebook, ...) for a user.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // WHICH IDENTITY MINTED THIS SESSION (ugcportal-mzr): the provider the
  // sign-in came through (an id from SIGN_IN_PROVIDERS — `google`,
  // `facebook`; canonicalised by `providerId` on the way in, so the value
  // here is always one the reader will recognise or NULL, never something
  // in between) and the address that provider asserted for it. Written in
  // the row's own INSERT, by the adapter wrapper in
  // src/lib/live-session.ts: the `signIn` callback puts the identity in an
  // AsyncLocalStorage slot for the request, and `createSession` reads it.
  // Not a second write afterwards — two sign-ins by one person at the same
  // moment leave two indistinguishable rows, and nothing that looks for
  // "the newest unattributed one" can tell them apart (PR #91 review,
  // round 2, finding 1).
  //
  // Here, on the SESSION, and not on `User`. A user can hold several
  // sessions at once, minted through different providers and — once
  // ugcportal-t33p lands — under different addresses, and the per-request
  // re-check in src/lib/live-session.ts asks about the one session in front
  // of it. A per-user column answers a question nobody asked ("which
  // provider did this person last use, anywhere?"), and judging a session
  // by it means one device's sign-in can get another device's
  // still-permitted session refused (PR #91 review, round 1, finding 1).
  //
  // A DENORMALISATION — the provider also appears on `Account`, and the
  // address on `User` — and it earns that by being free to read: the
  // adapter's `getSessionAndUser` loads this row in the single query
  // `auth()` already makes, so the per-request check costs no extra query
  // (ugcportal-mzr K2). `Account` could not answer it anyway: it says which
  // providers are linked, never which one a given session came through.
  //
  // Nullable, and null is not "no identity": it is "not recorded" — a
  // session minted before these columns existed, or one the migration's
  // backfill could not attribute. `providerId` in src/lib/sign-in-policy.ts
  // maps an unrecognised provider to `null`, which fails closed against a
  // provider-bound entry; a null address falls back to `User.email`, which
  // is what the check judged before these columns existed.
  signInProvider String?
  signInEmail    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One row per uploaded file (ugcportal-8wa). `key` is the object's path in
// the S3-compatible bucket (see src/lib/s3.ts); the file bytes themselves
// live only in storage, never in the DB.
//
// `previewKey` points at the downscaled, watermarked copy (ugcportal-44q,
// see src/lib/watermark.ts) and is the *only* object anything browsable may
// expose — `key` is the paid original (ugcportal-5d6) and must never reach
// the gallery. Nullable because VIDEO rows have no preview yet (watermarked
// poster frames are deferred, see ugcportal-pmb) and because rows created
// before this column existed have none either.
//
// `previewId` is the *public handle* for that preview, and exists because a
// storage path is not a safe public identifier. `previewKey` is built as
// `previews/{userId}/{uuid}.webp`, so handing it to an anonymous caller
// publishes the uploader's account id in plain text — page the public feed,
// split each key on "/", and you have a per-uploader index of the whole
// gallery. That is the exact capability withholding `userId` was meant to
// deny (ugcportal-r1d review, round 2), and it is the same class of mistake
// ugcportal-44q already avoided one field over when it made the preview's
// UUID uncorrelated with the original's.
//
// So: `previewKey` (a storage path, owner-only) and `previewId` (an opaque
// random id, safe for anyone) are deliberately separate values with no
// derivation between them. Set together at upload and null together, so
// "has a watermarked preview" is one fact, not two that can disagree.
//
// `publishedAt` is the visibility switch (ugcportal-r1d): null means the row
// is private to its owner, a timestamp means it is in the public listing and
// records since when. Nullable with no default, so the migration that adds it
// cannot retroactively publish an existing row and every future upload starts
// private. Unpublishing writes null back rather than deleting anything.
//
// Visibility is NOT sellability. Whether an item may be sold is decided by the
// resale-rights gate (ugcportal-0ss, re-anchored by ugcportal-vsm), which reads
// its own records — the uploader's ResaleRightsReview and this row's
// MediaListing. Nothing about this column feeds that decision, and no publish
// code path may write price or licence state.
model Media {
  id           String    @id @default(cuid())
  userId       String
  kind         MediaKind
  key          String    @unique
  previewKey   String?   @unique
  previewId    String?   @unique
  mimeType     String
  sizeBytes    Int
  originalName String
  // Accessibility and discoverability text (ugcportal-gwr) — the fields that
  // replace `originalName` as the thing a screen reader or a search index
  // reads about this image. Both nullable with no default, the same "null
  // means not yet decided" idiom MediaListing's triage booleans use below:
  // the upload form asks for `altText` but does not have to receive it, and
  // nothing at this layer forces a value in.
  //
  // `altText` is enforced at exactly one place — POST /api/media/[id]/publish
  // refuses to set `publishedAt` while this is null or blank (K1) — not here
  // and not at upload. A schema-level NOT NULL would also bind every other
  // writer this table will ever get (ugcportal-ct0's Instagram sync, for one)
  // to supplying a value before a row can exist at all, which is a stronger
  // and separate claim from "may not be PUBLISHED without one". The render
  // layer (toGalleryItem in src/lib/gallery-items.ts) still never emits an
  // empty alt or `originalName` as a fallback even if this invariant is ever
  // violated upstream — see that module for why defence in depth is kept
  // there too rather than trusted entirely to the publish gate.
  //
  // `caption` is optional everywhere, upload through publish. Both are plain
  // text, escaped like any other React text node — no inline markup or link
  // support in this iteration (product decision, ugcportal-gwr; revisit if a
  // future bead wants rich captions).
  altText      String?
  caption      String?
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Subject tags (ugcportal-jsc). Many-to-many, because one photograph really
  // is more than one subject — a wine shot for a cookbook is food and books —
  // and forcing a single choice would make the label a lie rather than a
  // simplification.
  //
  // An IMPLICIT relation (Prisma manages `_MediaToTag`) rather than an
  // explicit join model, because there is nothing to record about the pairing
  // itself: who attached a tag and when is not a question this product asks,
  // and an explicit model would be a third table and a nested select to store
  // no additional fact. If that changes it is a migration, not a reason to
  // pre-build one now.
  tags    Tag[]
  // The sale record for this upload, if an admin has put it forward
  // (ugcportal-vsm). Optional, and its absence is not sellable — see
  // `not_listed_for_sale` in src/lib/resale-rights.ts.
  listing MediaListing?
  // The advertising-disclosure record for this upload (ugcportal-qnq9.1),
  // if the operator has answered "was a benefit received for this". A
  // SEPARATE table rather than columns here, and separate from
  // MediaListing's triage too — see MediaAdvertisingDisclosure's own
  // comment at the bottom of this file for why those are three different
  // questions.
  advertisingDisclosure MediaAdvertisingDisclosure?

  @@index([userId])
  // Matches the listing query in GET /api/media exactly: filter on userId,
  // then ORDER BY createdAt DESC, id DESC. Without it SQLite re-sorts the
  // user's entire row set on every page, which would defeat the keyset
  // pagination the endpoint is built around. The plain [userId] index above
  // is kept for the lookups that don't order.
  @@index([userId, createdAt, id])
  // Matches the public listing in GET /api/public/media: no userId to scope
  // by, so the ordering columns lead. Verified against SQLite 3 with 20k rows
  // (EXPLAIN QUERY PLAN): with this index the first page is
  // "SCAN Media USING INDEX Media_createdAt_id_idx" with no temp B-tree, and a
  // keyset page becomes a SEARCH. The obvious-looking alternative,
  // [publishedAt, createdAt, id], is *not* chosen by the planner at all —
  // `publishedAt IS NOT NULL` is a range over the leading column, so the index
  // can no longer supply the sort order and SQLite falls back to a full scan
  // plus a temp B-tree. The publishedAt/previewKey predicates are applied as
  // filters during the scan instead.
  //
  // KNOWN LIMITATION — that EXPLAIN evidence proves *ordering*, not
  // *selectivity*, and the difference matters. Because publishedAt, previewKey
  // and previewId are filters applied during the scan rather than part of the
  // index key, a public-feed page costs work proportional to the total number
  // of Media rows in the range, not to the published ones. This is a scaling
  // note rather than a live problem at today's row counts; it is recorded
  // because GET /api/public/media is unauthenticated, so the work is reachable
  // without an account, and because the plan above looks clean and hides it.
  // The single before/after measurement for this scenario — row count,
  // seeding, timing method, and the result — is recorded once, below, next to
  // the fix it measures; it is not repeated here to avoid two numbers for the
  // same scenario silently drifting apart.
  //
  // RESOLVED (ugcportal-ei7): the fix above was a partial index. Prisma 7.10
  // *can* express one for sqlite — `@@index([createdAt, id], where: raw(...))`
  // behind `previewFeatures = ["partialIndexes"]` (generator block, above) —
  // and `migrate diff` emits exactly the intended `CREATE INDEX ... WHERE ...`
  // with no drift: same index name, so the migration is a plain DROP+CREATE
  // of this one index rather than two indexes doing the same job.
  //
  // The WHERE clause mirrors the public feed's own filter exactly (PUBLIC_
  // MEDIA_SCOPE in src/lib/public-media.ts) — publishedAt, previewKey AND
  // previewId all IS NOT NULL. All three, not just the two measured in the
  // original scratch test (ugcportal-ei7's notes), because a mismatch between
  // the index's predicate and the feed's would not break correctness — SQLite
  // still re-checks every predicate in the `where` against the row before
  // emitting it, partial index or not — but it would silently defeat the
  // point of this change: a row that qualifies for the feed but not for the
  // index's narrower WHERE falls back to a full-table scan to find it, right
  // back to the cost this index exists to remove. K3 in the bead is this
  // exact failure mode, guarded by a migration test that asserts the index's
  // WHERE clause by reading sqlite_master directly, not by trusting this
  // comment.
  //
  // THE measurement for this change — the only one recorded for this
  // scenario, so there is one number to keep in sync rather than two that can
  // silently disagree. Method: a scratch temporary SQLite database
  // (`createTemporaryDatabase`/`applyMigrations`, src/lib/test-support/db.ts),
  // seeded with 200,000 Media rows in one User's name, 1% of them published
  // with both preview columns set (every 100th row by insertion order) and
  // 99% left unpublished with no preview columns — the same shape `GET
  // /api/public/media` sees in production, just smaller. Measured 2026-10-04
  // on SQLite 3 by running the feed's own first-page query (`createdAt desc,
  // id desc`, `LIMIT 50`) through the real Prisma/libSQL client 20 times in a
  // loop and averaging the wall time with `process.hrtime.bigint`, once
  // against the plain index and once against the partial index, migrating
  // between the two runs rather than reusing one connection across both (see
  // ugcportal-ei7's notes for why: reusing one risks a stale read lock on
  // Media racing the migration's DROP/CREATE INDEX).
  //
  // Not re-run in CI, since a seed that size has no place in the test suite;
  // src/lib/media-public-feed-index-migration.test.ts instead asserts the
  // index's WHERE clause and the feed's correctness on every run, which is
  // what would actually regress silently if this drifted.
  //
  //   BEFORE (plain @@index([createdAt, id])):
  //     EXPLAIN QUERY PLAN: "SCAN Media USING INDEX Media_createdAt_id_idx"
  //     avg over 20 runs: ~0.6-0.7ms.
  //   AFTER (this partial index, same name since it replaces the old one):
  //     EXPLAIN QUERY PLAN text is IDENTICAL — SQLite's plan summary names the
  //     index, not its row count, so the improvement does not show up as
  //     different plan text. It shows up as a different `sqlite_master`
  //     definition (the index now carries the `WHERE ...` clause — assert
  //     this directly, not the plan string, which is exactly what the
  //     migration test does) and as wall time: avg over 20 runs ~0.11-0.12ms,
  //     roughly 5-6x faster at this row count.
  //
  // The old index's cost scales with total Media rows walked before 50
  // published ones turn up; the new index's cost scales with the published
  // subset instead, because the unqualifying rows are no longer in it to
  // walk past. No further ratio is claimed beyond the measured ~5-6x above —
  // the gap is expected to widen as the table grows past this scratch size,
  // but that is a direction, not a number this comment measured.
  //
  // This index now serves exactly one query: the public feed's three-predicate
  // filter above (publishedAt/previewKey/previewId all IS NOT NULL) plus its
  // (createdAt, id) ordering. It is intentionally not kept name-generic for
  // other callers — `Media_userId_createdAt_id_idx`, from `@@index([userId,
  // createdAt, id])` above, is the one for user-scoped listings (GET
  // /api/media), and stays a plain, non-partial index because it is already
  // selective on `userId` and must keep serving an owner's own unpublished
  // rows. Keep the two indexes' jobs separate rather than trying to widen
  // either one to also cover the other's query.
  @@index([createdAt, id], where: raw("publishedAt IS NOT NULL AND previewKey IS NOT NULL AND previewId IS NOT NULL"))
}

// One subject tag (ugcportal-jsc). A TABLE rather than an enum, deliberately:
// the four subject areas in use — food, wine & drink, technology, books — are
// the ones expected today, not a closed set decided here, and adding a fifth
// must not be a migration. It is a row.
//
// Tags are LABELS ON ITEMS in one gallery. There is no per-tag page, no
// per-tag navigation entry and no per-tag section, and that is the product
// decision this bead was rescoped around rather than an omission: with an
// uneven library (fifteen food, one coffee, one technology) per-section pages
// present nearly empty rooms and the navigation permanently advertises the
// thin ones.
model Tag {
  id String @id @default(cuid())

  // The identity key: `name` case-folded, with every run of non-letter,
  // non-digit characters collapsed to a hyphen (see `tagSlug` in
  // src/lib/tags.ts). It exists so "Food" and "food" are one tag rather than
  // two — SQLite's unique index is case-sensitive, so uniqueness on `name`
  // would not give that.
  //
  // NOT a URL component, and nothing builds one from it. K4 forbids a per-tag
  // route, so the only thing this value addresses is a row.
  slug String @unique

  // What a visitor actually reads, as the first writer to use the tag spelled
  // it. A later writer whose name normalises to the same slug does NOT rewrite
  // it: a display name that changes under everyone because somebody typed
  // different capitals is a worse outcome than one fixed at first use.
  name String

  // Whether this subject is offered to everyone in the upload page's picker.
  //
  // THE PICKER IS A SHARED SURFACE AND THE TAG TABLE IS NOT A TRUSTED ONE.
  // Any account permitted to sign in can mint a tag by naming it on its own
  // upload — so without this column the picker showed whichever names
  // happened to be created first, to every user, permanently. Four subjects
  // ship; the rest of the window was free and first-come. ugcportal-egp
  // decides who may sign in at all and closed the "anyone with a Google
  // account" hole, which narrows the set but does not change the shape: an
  // uploader is not an administrator of everybody else's form.
  //
  // Defaults to FALSE, so minting a tag is exactly as available as it was and
  // reaches exactly one place: the item its author put it on. Their own
  // published photograph carrying their own label is the feature. Everybody
  // else's upload form is not.
  //
  // A FLAG RATHER THAN A DELETE PATH, which was the other obvious remedy and
  // is the more dangerous one: `_MediaToTag` cascades, so deleting a Tag row
  // silently strips that subject from every item pointing at it, including
  // other people's. Un-curating is reversible and touches nobody's media.
  //
  // Who may set it is ugcportal-x0l's decision. Until that lands the answer
  // is "the migration that seeds the four subjects", which is a deliberate
  // set rather than a race.
  curated Boolean @default(false)

  createdAt DateTime @default(now())

  media Media[]
}

// One connected Instagram account whose media can be synced (ugcportal-ct0)
// and later curated for sale (ugcportal-74w). Several accounts can be
// connected; `connectedBy` records which admin authorised this one.
//
// `accessTokenEncrypted` holds a long-lived Instagram token sealed with
// AES-256-GCM (see src/lib/crypto.ts) rather than the plaintext the Auth.js
// `Account` table stores — these tokens are a standing capability over
// someone else's content, not a login artefact, so they never sit in the
// clear at rest. Refresh before `tokenExpiresAt` is ugcportal-cud's job.
model InstagramAccount {
  id                   String   @id @default(cuid())
  instagramUserId      String   @unique
  username             String
  accessTokenEncrypted String
  tokenExpiresAt       DateTime
  scopes               String
  connectedByUserId    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // No resale-rights relation any more (ugcportal-vsm). The gate is anchored
  // to the uploader and the upload; a connected account is plumbing for
  // discovery (ugcportal-ct0) and confers no right to sell anything. The
  // events recorded against accounts under the old anchor survive in
  // ResaleRightsEvent, which has never had a foreign key back here.
  connectedBy User @relation(fields: [connectedByUserId], references: [id], onDelete: Cascade)

  @@index([connectedByUserId])
}

// Where a role change came from. `BOOTSTRAP` is the first-admin path, which
// by definition has no admin behind it (see ADMIN_BOOTSTRAP_EMAILS in
// env.example); `ADMIN` is every change made from the admin users screen.
enum RoleChangeSource {
  BOOTSTRAP
  ADMIN
}

// Append-only audit trail of every User.role change (ugcportal-lu7). Nothing
// updates or deletes these rows; the current role lives on User, this is the
// history of how it got there.
//
// Deliberately carries no foreign keys. An audit row whose FK cascades away
// when the user is deleted stops being an audit trail exactly when it matters
// most, and a restricting FK would block deleting a user at all (GDPR erasure
// is ugcportal-x1a's problem, not something an audit log should veto). The ids
// are kept as plain strings, with the email snapshotted alongside so a row
// still reads sensibly after the account is gone.
model RoleChange {
  id           String           @id @default(cuid())
  targetUserId String
  targetEmail  String?
  previousRole Role
  newRole      Role
  source       RoleChangeSource
  actorUserId  String?
  actorEmail   String?
  createdAt    DateTime         @default(now())

  @@index([targetUserId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Resale rights (ugcportal-0ss, re-anchored by ugcportal-vsm).
//
// Part E of docs/legal/instagram-resale-rights-checklist.md is the
// enforcement half of the ugcportal-zec legal review. ugcportal-0ss built it
// against connected Instagram accounts, because the sellable catalogue was
// expected to come from them. Instagram was deferred on 2026-09-24 and the
// product is built around manually uploaded images and video, so the gate is
// anchored where the files actually are:
//
//   * ResaleRightsReview is one standing review per UPLOADER (User). It
//     answers "may this person's own work be resold at all, on what route,
//     against which checklist version, until when".
//   * MediaListing is one sale record per UPLOAD. It answers "what is in
//     this specific file" (the Part C triage) and carries the price.
//   * MediaRightsClearance is one admin-signed justification per rights
//     LAYER on one upload, for the layers that are actually present.
//
// All three are required, in that order, for anything to be sellable. The
// uploader's clearance is a precondition, not a licence to sell whatever
// they upload: an identifiable person, licensed music, an uncredited
// collaborator and undisclosed sponsorship are properties of the file.
//
// Why the anchor matters and not just the mechanism: the gate finds the
// governing review by following Media.userId, a column the upload path wrote
// and that no listing author picks. There is no second value for it to
// disagree with, which is why ugcportal-0ss's `clearedOwnerUserId`
// comparison is gone rather than ported.
// ---------------------------------------------------------------------------

// Per-uploader resale-rights position. `UNREVIEWED` is the default and the
// fail-closed state; a *missing* ResaleRightsReview row means exactly the
// same thing (see evaluateSellability in src/lib/resale-rights.ts), so
// forgetting to create the row can never make something sellable.
enum ResaleRightsStatus {
  UNREVIEWED
  IN_REVIEW
  CLEARED
  REJECTED
  REVOKED
  EXPIRED
}

// How the rights were obtained (checklist Part B). Recorded for the audit;
// not read by the gate.
enum ResaleRightsRoute {
  CONTRACT
  OWN_TERMS_ACCEPTANCE
  EXPLICIT_CONSENT
}

// The rights layers that vary per upload (checklist Part C.2–C.5) and can be
// present but handled. Each is cleared on its own: a licence for the music
// says nothing about an uncredited third-party creator, and neither says
// anything about undisclosed sponsorship.
//
// PEOPLE was initially left out on the grounds that it is settled by a model
// release on file rather than by a written justification. That was wrong in
// the direction that matters: it made the one layer with a named individual
// behind it the *loosest* of the four, settled by a free-text key and a
// boolean with no author. A release now needs both — the file, and an admin
// who says it covers this use (åndsverkloven § 104, GDPR art 9).
enum RightsLayer {
  PEOPLE
  MUSIC
  THIRD_PARTY_CREATOR
  SPONSORED_CONTENT
}

// What a ResaleRightsEvent row was recorded against.
//
// Exists because this table is append-only and outlives its subjects, so it
// still holds rows written while the anchor was a connected Instagram
// account (ugcportal-0ss). Deleting or rewriting those would be destroying
// the audit trail to tidy up a refactor. `INSTAGRAM_ACCOUNT` is therefore a
// *historical* value: nothing writes it any more, and the migration that
// re-anchored the gate stamped it onto the rows that already existed.
enum RightsSubjectKind {
  UPLOADER
  INSTAGRAM_ACCOUNT
}

// One review per uploader. A separate table rather than columns on User so
// the account row stays about identity, and so the history
// (ResaleRightsEvent) hangs off the thing it describes.
//
// Only an authenticated ADMIN may ever write status = CLEARED - see
// setResaleRightsStatus in src/lib/resale-rights-review.ts, the only writer
// of this column in the codebase (checklist Part E.3, ugcportal-0ss K4). No
// migration default, sync job or OAuth callback may produce it.
model ResaleRightsReview {
  id                 String             @id @default(cuid())
  // THE anchor (ugcportal-vsm). Whose uploads this review governs. Unique,
  // so one uploader can never have two reviews and leave the gate choosing
  // between them - the same argument as the per-layer unique index below.
  //
  // This replaces ugcportal-0ss's `instagramAccountId` *and* its
  // `clearedOwnerUserId`. The latter existed to name whose rights a
  // per-account clearance covered, so the gate could compare it against the
  // file's owner. With the review hanging off the uploader directly, the
  // gate reaches it *through* Media.userId and there is nothing left to
  // compare - a listing's author cannot point at somebody else's clearance
  // because they do not choose which clearance applies.
  uploaderUserId     String             @unique
  status             ResaleRightsStatus @default(UNREVIEWED)
  route              ResaleRightsRoute?
  // Version of docs/legal/instagram-resale-rights-checklist.md the reviewer
  // worked through. Revising the checklist retires old versions, which makes
  // every uploader cleared under one stop being sellable until re-reviewed
  // (see ACCEPTED_CHECKLIST_VERSIONS in src/lib/resale-rights.ts).
  checklistVersion   String
  // Must refer to a user with role ADMIN - set by the admin route handler
  // and re-checked at read time by the gate, because a reviewer can be
  // demoted after the clearance was recorded.
  reviewedByUserId   String?
  reviewedAt         DateTime?
  validUntil         DateTime?
  conditions         String?
  // Object key under the private rights-evidence/ prefix (see
  // src/lib/rights-evidence.ts). Never a Media row: evidence is contracts and
  // personal data, not a sellable asset.
  evidenceKey        String?
  evidenceSha256     String?
  // Bead id of the product decision this clearance was made under - today
  // ugcportal-2eh (Option A: the sellable file is always the owner-uploaded
  // original from ugcportal-8wa).
  productDecisionRef String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Cascade: a deleted user has no uploads left to sell, so the current-state
  // row goes with them. The audit trail does not - ResaleRightsEvent has no
  // foreign keys, deliberately (see below and ugcportal-lu7).
  uploader   User  @relation("ResaleRightsSubject", fields: [uploaderUserId], references: [id], onDelete: Cascade)
  // Deleting the *reviewer* nulls this column (ON DELETE SET NULL), which
  // makes the gate block with `reviewer_not_admin` rather than deleting the
  // clearance or leaving it signed by nobody.
  reviewedBy User? @relation("ResaleRightsReviewer", fields: [reviewedByUserId], references: [id])
  // No `events` relation field: ResaleRightsEvent deliberately carries no
  // foreign key back here, so that deleting the uploader cannot delete the
  // history. Read events by `reviewId` or by (`subjectKind`, `subjectId`).

  @@index([reviewedByUserId])
}

// Append-only audit trail of every status transition. Nothing updates or
// deletes these rows; the current status lives on ResaleRightsReview, this is
// the history of how it got there.
//
// Carries no foreign keys, for the same reason RoleChange doesn't
// (ugcportal-lu7): an audit row that cascades away stops being an audit trail
// exactly when it matters most. Under the old anchor that cascade ran on one
// click of Disconnect; under this one it would run on deleting a user. Either
// way the row you most want is the one describing rights that have just
// ended.
//
// So the ids are plain strings and the facts a reader needs are snapshotted
// alongside them: who the subject was and what they were called, the
// checklist version in force, and the evidence pointer at the moment of the
// decision. The review row remains the *current* state; this table is the
// history, and it outlives it.
model ResaleRightsEvent {
  id               String              @id @default(cuid())
  // Not a relation: the review row it describes may already be gone.
  reviewId         String
  // Who or what the decision was about. `subjectId` is a plain string for
  // the same reason everything else here is - the row has to survive the
  // subject. `subjectLabel` is the snapshotted human-readable name (an
  // email for an uploader, an @handle for a historical Instagram account),
  // so a reader does not need the other table to be present.
  subjectKind      RightsSubjectKind
  subjectId        String
  subjectLabel     String?
  fromStatus       ResaleRightsStatus?
  toStatus         ResaleRightsStatus
  // Null only for system transitions, which may never produce CLEARED.
  actorUserId      String?
  actorEmail       String?
  reason           String
  // Separation of duties (checklist Part E.3): true when the reviewer is the
  // uploader whose rights are being decided - an admin clearing their own
  // uploads for sale. Soft - recorded and surfaced in the admin UI rather
  // than refused, because a single-admin instance has no other option
  // (ugcportal-0ss K3).
  selfReview       Boolean             @default(false)
  // Snapshots of the decision's own terms, so the row still answers "cleared
  // against what, on what evidence" with no other table present. Also the
  // only remaining record of which objects under rights-evidence/ belong to a
  // deleted subject (purging them is ugcportal-69p's job).
  checklistVersion String?
  evidenceKey      String?
  evidenceSha256   String?
  createdAt        DateTime            @default(now())

  @@index([reviewId, createdAt])
  @@index([subjectKind, subjectId, createdAt])
  @@index([createdAt])
}

// One upload (ugcportal-8wa Media row) put forward for sale, with the Part C
// triage that decides whether it may be.
//
// 1:1 with Media, and a real foreign key now that ugcportal-r1d has landed:
// under ugcportal-0ss this was `CuratedPost` with an unconstrained `mediaId`
// string, so a dangling pointer was possible and the gate had to load the
// row separately just to find out. The gate now starts at the Media row and
// follows the relation, which removes the question rather than answering it.
//
// The triage lives here rather than on Media because it is a decision an
// admin records, not a property of the file the uploader gave us. The upload
// path therefore writes nothing on this table at all.
//
// It does write the one Media column the gate reads - `userId`, the anchor -
// and that is fine rather than an exception: POST /api/media takes it from
// the session, never from the request body, so an uploader can only ever
// attach their own clearance to their own file. An earlier draft of this
// comment claimed the upload path "must never be able to write anything the
// gate reads", which was simply false.
model MediaListing {
  id      String @id @default(cuid())
  mediaId String @unique

  // Null until an admin sets a price through the gated endpoint
  // (src/app/api/admin/curation/[id]/price/route.ts). Integer minor units, so
  // no float ever touches money.
  priceCents Int?
  currency   String @default("NOK")

  // Per-upload triage (checklist Part C / Part E.1). `null` means "not
  // triaged", which is not sellable - absence is never consent.
  depictsPeople     Boolean?
  modelReleaseKey   String?
  containsMusic     Boolean?
  thirdPartyCreator Boolean?
  sponsoredContent  Boolean?
  // Who completed the triage above, and when.
  //
  // Read by the gate, not just recorded: every flag here is an assertion
  // about someone else's rights - "no identifiable people", "no music" -
  // and an unattributed assertion is not one this instance can stand
  // behind. The gate requires this to name a user who is an ADMIN *now*,
  // so a curator, or an admin since demoted, cannot declare a photograph of
  // a person to be people-free and have it sell.
  //
  // It is still not a clearance: a layer that is *present* is settled by
  // its own MediaRightsClearance row.
  triagedByUserId   String?
  triagedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media           Media                  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  triagedBy       User?                  @relation("MediaListingTriager", fields: [triagedByUserId], references: [id])
  layerClearances MediaRightsClearance[]

  @@index([triagedByUserId])
}

// One justification for one rights layer on one upload (checklist Part C).
//
// A row per layer, rather than one clearance covering the upload, because the
// layers are unrelated: a purchased music licence is not an answer about an
// uncredited collaborator, and neither is an answer about undisclosed
// sponsorship. An earlier revision of this had a single item-level clearance,
// which meant one reason of "music licence purchased" silently settled all
// three - the gate's contract inverted.
//
// `clearedBy` is a relation, not a snapshot, because the gate re-reads the
// clearer's role at evaluation time: a justification signed by someone who
// has since been demoted is not one this instance stands behind. Audit
// durability is the ResaleRightsEvent table's job, not this one's - these
// rows describe current state.
model MediaRightsClearance {
  id              String      @id @default(cuid())
  listingId       String
  layer           RightsLayer
  reason          String
  clearedByUserId String?
  clearedAt       DateTime    @default(now())

  listing   MediaListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  clearedBy User?        @relation("MediaRightsClearer", fields: [clearedByUserId], references: [id])

  // One live justification per layer. A second one would leave the gate
  // choosing between two answers to the same question.
  @@unique([listingId, layer])
  @@index([clearedByUserId])
}

// --- advertising disclosure (ugcportal-qnq9.1) -------------------------------
//
// Forbrukertilsynet's labelling rule (docs/ugc-research.md §3.2): any item the
// operator received payment or another benefit for must carry a prominent
// advertising label, and the label must come first. §5.7 adds that posting in
// English does not change this, because the site is run from Norway.
//
// THIS IS NOT THE RESALE TRIAGE, and the two must not be folded together.
// MediaListing.sponsoredContent and RightsLayer.SPONSORED_CONTENT answer "may
// this be RESOLD" for the sellability gate (src/lib/resale-rights.ts). A brand
// deal that blocks resale and a brand deal that must be labelled are different
// questions with different answers: an item can be perfectly sellable and still
// need a label, and an unsellable item is not thereby an advertisement.

/// What the operator received. The six kinds §3.2 names ("free or loaned
/// products, discounts, trips and events") plus plain payment.
///
/// An ENUM rather than a Tag-style row, which is the opposite of the call
/// ugcportal-jsc made for subject tags — deliberately. A subject tag is an
/// open vocabulary the operator invents ("coffee" was not foreseen); this is
/// a closed list taken verbatim from a regulator's text, and a seventh kind
/// appearing means the regulator's guidance changed, which is a migration and
/// a re-read of §3.2, not a row somebody types into a form.
enum BenefitKind {
  PAYMENT
  FREE_PRODUCT
  LOANED_PRODUCT
  DISCOUNT
  TRIP
  EVENT_INVITATION
}

/// The brand behind a benefit — who paid, or who sent the free product.
///
/// A TABLE, NOT A STRING COLUMN on the disclosure, and the reason is a
/// requirement that does not exist yet: ugcportal-qnq9.3 K4 has to answer "does
/// this brand produce, import or sell alcohol" and refuse the benefit if it
/// does (§3.1a practical rule 1). That answer belongs to the brand, not to one
/// item — "Vinmonopolet" is the same answer on every item it ever appears on —
/// so free text here would mean either re-asking per item or inventing a
/// brand table later and migrating every spelling anyone ever typed. This bead
/// does not add the alcohol column; it makes the place for it exist.
///
/// `slug` is the identity key and `name` the display form, the same split
/// Tag uses and for the same reason: "Riedel" and "riedel" are one brand, and
/// an alcohol answer recorded against one spelling must not be bypassable by
/// typing another.
model BenefitSource {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosures MediaAdvertisingDisclosure[]
}

/// One item's advertising-disclosure record (ugcportal-qnq9.1).
///
/// 1:1 with Media and optional, so an item that nobody has answered the
/// question for has NO ROW. That is the same "absence means not yet decided"
/// idiom MediaListing's triage booleans use, one level up: the row's absence
/// and `benefitReceived = NULL` both mean unanswered, and exactly one function
/// collapses the two — `advertisingLabelPublishRefusal` in
/// src/lib/advertising-disclosure.ts. Do not add a second reader that checks
/// only one of them.
///
/// WHAT UNANSWERED DOES TODAY: nothing. An item with no row publishes exactly
/// as it did before this bead, because every row that existed when this
/// migration ran is in that state and there is no backfill that could honestly
/// answer the question for them. `benefitReceived` is nullable rather than
/// `Boolean @default(false)` precisely so that "nobody has said" stays
/// distinguishable from "somebody said no" — which is what would let a later
/// bead (ugcportal-qn3's unanswered-question-blocks-publishing mechanism, if it
/// lands) move this field onto that mechanism without a second migration to
/// recover a distinction a default had already thrown away.
model MediaAdvertisingDisclosure {
  id      String @id @default(cuid())
  mediaId String @unique

  /// Was a benefit received for this item? NULL means unanswered — see the
  /// model comment above.
  benefitReceived Boolean?
  /// What the benefit was, and who it came from. Both required by the write
  /// path (PUT /api/media/[id]/disclosure) whenever `benefitReceived` is true,
  /// and both null otherwise; nullable here because "no benefit" and
  /// "unanswered" are the ordinary states and neither has a kind or a source.
  benefitKind     BenefitKind?
  benefitSourceId String?

  /// The benefit's market value in ØRE — integer minor units of NOK, so no
  /// float ever touches money (the same rule MediaListing.priceCents states,
  /// which uses the minor-unit convention under a cent-flavoured name; this
  /// column is named for the unit it actually holds).
  ///
  /// §3.3: free and discounted products are taxable income AT MARKET VALUE.
  /// Recorded here because this is where the benefit is already being written
  /// down, and optional because the value of an event invitation is often
  /// genuinely unknown at the moment the label is set. Whether the income log
  /// REQUIRES it is ugcportal-qnq9.6's call, not this bead's — this bead only
  /// makes sure the number has somewhere true to live.
  marketValueOre Int?

  /// The advertising label as it will be rendered, e.g. "Advertisement /
  /// Reklame". Validated against a closed allowlist before it is stored
  /// (`validateAdvertisingLabel`, src/lib/advertising-disclosure.ts) and
  /// re-checked by the publish gate, which does not trust that every row was
  /// written through that validator.
  ///
  /// Nullable, because an item with no benefit has no label and a label on
  /// honest content is itself misleading (K4). It is NOT nullable in
  /// combination with `benefitReceived = true`: that pair is what the publish
  /// gate refuses, and what the write path refuses to create in the first
  /// place.
  label String?

  /// When the declaration was last changed. This is a compliance record about
  /// a commercial relationship, so "as of when" is part of what it says.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media         Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade or SetNull: deleting a brand must not silently
  /// erase the source of a benefit that was declared publicly. There is no
  /// delete path for a BenefitSource in the product; this makes adding one a
  /// deliberate act rather than a quiet data loss.
  benefitSource BenefitSource? @relation(fields: [benefitSourceId], references: [id], onDelete: Restrict)

  @@index([benefitSourceId])
}
