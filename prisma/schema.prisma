// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum MediaKind {
  IMAGE
  VIDEO
}

// Core user record. Shape follows the Auth.js Prisma adapter convention
// (https://authjs.dev/getting-started/adapters/prisma) so the upcoming
// Google/Facebook OAuth work (ugcportal-3vy, ugcportal-3zj) can plug in
// without a schema migration.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  media    Media[]
}

// One row per linked login provider (Google, Facebook, ...) for a user.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One row per uploaded file (ugcportal-8wa). `key` is the object's path in
// the S3-compatible bucket (see src/lib/s3.ts); the file bytes themselves
// live only in storage, never in the DB.
model Media {
  id           String    @id @default(cuid())
  userId       String
  kind         MediaKind
  key          String    @unique
  mimeType     String
  sizeBytes    Int
  originalName String
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
